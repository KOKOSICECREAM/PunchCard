# Copy to .env and fill in. .env is gitignored — never commit a key.
#
# Use a THROWAWAY key that has only testnet funds on it. Better still, use a foundry
# keystore and --account instead of a raw key:
#   cast wallet import pc-testnet --interactive
#   forge script ... --account pc-testnet

BASE_SEPOLIA_RPC=https://sepolia.base.org

# --- PunchCard roles (testnet: all three can be your own address) ---
PC_MULTISIG=
PC_DEPLOYER=
PC_FEE_RECIPIENT=

# --- Base Sepolia externals (verified on-chain 2026-09-13) ---
PC_POSITION_MANAGER=0x27F971cb582BF9E50F397e4d29a5C7A34f11faA2
PC_SWAP_ROUTER=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4
PC_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
PC_WETH=0x4200000000000000000000000000000000000006
PC_ETH_USD_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1

# --- policy: 8dp USD. Testnet $5/$5; mainnet would be 200000000000 / 300000000000 ---
PC_MIN_USDC_SEED_USD=500000000
PC_MIN_ETH_SEED_USD=500000000
PC_ROUTER_FEE_BPS=30
